<script>
(function () {
  'use strict';

  // Mark this document so iframe-only CSS activates.
  document.documentElement.classList.add('clinic-iframe');

  // ──────────────────────────────────────────────────────────
  // Height reporting — tells the parent (Wix) how tall we are
  // so it can resize the iframe and avoid inner scrollbars.
  // We send messages in a few formats to maximize compatibility
  // with Wix's various embed widgets and other common hosts.
  // ──────────────────────────────────────────────────────────

  function getDocHeight() {
    var doc = document.documentElement;
    var body = document.body;
    return Math.max(
      body.scrollHeight, body.offsetHeight,
      doc.scrollHeight, doc.offsetHeight, doc.clientHeight
    );
  }

  var lastHeight = 0;

  function reportHeight() {
    try {
      var h = getDocHeight();
      // Avoid spamming identical values
      if (h === lastHeight) return;
      lastHeight = h;

      // Most-common postMessage formats. Parents that don't
      // recognize them simply ignore the message — no harm.
      window.parent.postMessage({ type: 'resize', height: h }, '*');
      window.parent.postMessage({ height: h }, '*');
      window.parent.postMessage('clinic-height:' + h, '*');
    } catch (e) {
      // Cross-origin or parent unavailable — silently ignore.
    }
  }

  // Initial reports — multiple times because fonts and images
  // can change layout after first paint.
  reportHeight();
  window.addEventListener('load', reportHeight);
  setTimeout(reportHeight, 250);
  setTimeout(reportHeight, 1000);
  setTimeout(reportHeight, 2500);

  // Re-report whenever content size changes (FAQ accordion
  // expanding, viewport rotating, fonts loading late).
  if (typeof ResizeObserver !== 'undefined') {
    try {
      var ro = new ResizeObserver(reportHeight);
      ro.observe(document.body);
    } catch (e) { /* graceful fallback */ }
  }

  window.addEventListener('resize', reportHeight);

  // FAQ <details> elements change height when toggled.
  document.querySelectorAll('details.faq').forEach(function (el) {
    el.addEventListener('toggle', function () {
      // Allow the open/close animation a moment, then report.
      setTimeout(reportHeight, 50);
      setTimeout(reportHeight, 350);
    });
  });

  // ──────────────────────────────────────────────────────────
  // Smooth in-iframe anchor scrolling — works even when the
  // browser ignores CSS scroll-behavior inside iframes.
  // ──────────────────────────────────────────────────────────
  document.querySelectorAll('a[href^="#"]').forEach(function (link) {
    link.addEventListener('click', function (e) {
      var id = link.getAttribute('href').slice(1);
      if (!id) return;
      var target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      var top = target.getBoundingClientRect().top + window.pageYOffset - 8;
      try {
        window.scrollTo({ top: top, behavior: 'smooth' });
      } catch (err) {
        window.scrollTo(0, top);
      }
    });
  });
})();
</script>

