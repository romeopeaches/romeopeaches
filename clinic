<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Pre-Tryout Clinic · Romeo Peaches</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
<style>
  /* ============================================================
     BRAND TOKENS — matched to the tryout page
     ============================================================ */
  .clinic-root {
    --green-deep:  #144733;
    --green-med:   #339C5E;
    --green-lime:  #7BC144;
    --coral:       #F1654F;
    --peach:       #FD8660;
    --cream:       #FFF1E0;
    --cream-soft:  #FBE6D5;
    --ink:         #0E2A1E;
    --ink-soft:    #2A4A3B;
    --line:        rgba(20, 71, 51, 0.14);
    --shadow-sm:   0 1px 2px rgba(20, 71, 51, 0.06);
    --shadow-md:   0 6px 22px rgba(20, 71, 51, 0.10);
  }

  .clinic-root *,
  .clinic-root *::before,
  .clinic-root *::after { box-sizing: border-box; }

  /* Iframe document — narrow rules for scroll behavior only.
     These affect the iframe document itself (not the parent Wix page)
     and are required for smooth in-iframe scroll on iOS. */
  html.clinic-iframe,
  html.clinic-iframe body {
    margin: 0;
    padding: 0;
    background: var(--cream);
    overflow-x: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  .clinic-root {
    /* Layout reset for our wrapper only */
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
    -ms-text-size-adjust: 100%;
    /* Typography */
    font-family: 'Libre Franklin', 'Franklin Gothic Medium', 'Franklin Gothic', 'ITC Franklin Gothic', Arial, sans-serif;
    color: var(--ink);
    background: var(--cream);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    -webkit-tap-highlight-color: rgba(241, 101, 79, 0.18);
  }
  .clinic-root h1, .clinic-root h2, .clinic-root h3, .clinic-root h4 {
    font-family: 'Libre Franklin', 'Franklin Gothic', Arial, sans-serif;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin: 0;
    overflow-wrap: break-word;
  }
  .clinic-root p { margin: 0 0 1em; }
  .clinic-root a { color: inherit; }
  .clinic-root img, .clinic-root svg { max-width: 100%; height: auto; }

  .clinic-root .wrap { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .clinic-root .eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--coral);
  }
  .clinic-root .btn {
    display: inline-block;
    padding: 16px 28px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    cursor: pointer;
    border: none;
  }
  .clinic-root .btn-primary {
    background: var(--green-deep);
    color: var(--cream);
    box-shadow: var(--shadow-md);
  }
  .clinic-root .btn-primary:hover { transform: translateY(-1px); background: var(--ink); }
  .clinic-root .btn-coral {
    background: var(--coral);
    color: #fff;
    box-shadow: var(--shadow-md);
  }
  .clinic-root .btn-coral:hover { transform: translateY(-1px); background: #d94e3a; }
  .clinic-root .arrow { display: inline-block; transform: translateY(1px); margin-left: 4px; }

  /* ============================================================
     1) TIMELY BANNER
     ============================================================ */
  .clinic-root .banner {
    background: var(--coral);
    color: #fff;
    text-align: center;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .clinic-root .banner strong { font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; }
  .clinic-root .banner a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }

  /* ============================================================
     2) HERO
     ============================================================ */
  .clinic-root .hero {
    position: relative;
    background:
      linear-gradient(180deg, var(--green-deep) 0%, #0d3324 100%);
    color: var(--cream);
    padding: 88px 0 96px;
    overflow: hidden;
  }
  .clinic-root .hero::after {
    content: "";
    position: absolute; inset: 0;
    background:
      radial-gradient(900px 500px at 85% 15%, rgba(253,134,96,0.22), transparent 60%),
      radial-gradient(800px 400px at 5% 95%, rgba(123,193,68,0.14), transparent 60%),
      radial-gradient(600px 300px at 50% 50%, rgba(241,101,79,0.08), transparent 65%);
    pointer-events: none;
  }
  }
  .clinic-root .hero-inner { position: relative; z-index: 1; }
  .clinic-root .hero .eyebrow { color: var(--peach); margin-bottom: 14px; }
  .clinic-root .hero h1 {
    font-size: clamp(40px, 6vw, 72px);
    text-transform: uppercase;
    max-width: 14ch;
    margin-bottom: 20px;
  }
  .clinic-root .hero h1 .accent { color: var(--peach); }
  .clinic-root .hero-sub {
    font-size: 18px;
    max-width: 60ch;
    color: rgba(255, 241, 224, 0.86);
    margin-bottom: 28px;
  }
  .clinic-root .hero-when {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 0;
    margin-bottom: 32px;
    background: rgba(253, 134, 96, 0.08);
    border: 1px solid rgba(253, 134, 96, 0.32);
    border-radius: 8px;
    overflow: hidden;
    backdrop-filter: blur(2px);
  }
  .clinic-root .hero-when-block {
    padding: 22px 26px;
    position: relative;
  }
  .clinic-root .hero-when-block + .hero-when-block {
    border-left: 1px solid rgba(253, 134, 96, 0.22);
  }
  .clinic-root .hero-when-eyebrow {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--peach);
    margin-bottom: 8px;
  }
  .clinic-root .hero-when-date-num,
  .clinic-root .hero-when-place {
    font-size: 26px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--cream);
    margin-bottom: 4px;
    letter-spacing: -0.01em;
  }
  .clinic-root .hero-when-time {
    font-size: 14px;
    color: rgba(255, 241, 224, 0.78);
    font-weight: 500;
  }
  .clinic-root .hero-when-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--peach);
    text-decoration: none;
    border-bottom: 1px solid rgba(253, 134, 96, 0.5);
    padding-bottom: 1px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .clinic-root .hero-when-link:hover {
    color: #fff;
    border-bottom-color: #fff;
  }
  .clinic-root .hero-when-link span {
    transition: transform 0.15s ease;
  }
  .clinic-root .hero-when-link:hover span {
    transform: translateX(2px);
  }

  .clinic-root .hero-cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 36px; }
  .clinic-root .hero-secondary {
    background: transparent;
    color: var(--cream);
    border: 1.5px solid rgba(255, 241, 224, 0.5);
    padding: 14.5px 26px;
  }
  .clinic-root .hero-secondary:hover { background: rgba(255, 241, 224, 0.08); }

  .clinic-root .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    padding-top: 28px;
    border-top: 1px solid rgba(255, 241, 224, 0.18);
  }
  .clinic-root .stat .num {
    font-size: 28px;
    font-weight: 800;
    color: var(--peach);
    letter-spacing: -0.02em;
  }
  .clinic-root .stat .lbl {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255, 241, 224, 0.8);
    margin-top: 4px;
  }

  /* ============================================================
     3) INTRO / WHY
     ============================================================ */
  .clinic-root .why { padding: 80px 0 24px; }
  .clinic-root .why h2 {
    font-size: clamp(30px, 4vw, 44px);
    text-transform: uppercase;
    margin-bottom: 16px;
    max-width: 18ch;
  }
  .clinic-root .why h2 .accent { color: var(--coral); }
  .clinic-root .why p {
    font-size: 17px;
    color: var(--ink-soft);
    max-width: 60ch;
  }


  /* ============================================================
     4) WHAT WE'LL COVER
     ============================================================ */
  .clinic-root .curriculum { padding: 64px 0 80px; }
  .clinic-root .curriculum-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    flex-wrap: wrap; gap: 20px; margin-bottom: 40px;
  }
  .clinic-root .curriculum-head h2 {
    font-size: clamp(28px, 4vw, 40px);
    text-transform: uppercase;
    max-width: 18ch;
    margin-top: 8px;
  }
  .clinic-root .curriculum-head h2 .accent { color: var(--coral); }
  .clinic-root .curriculum-head p {
    font-size: 15px; color: var(--ink-soft); margin: 0;
    max-width: 36ch;
  }

  .clinic-root .topic-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .clinic-root .topic-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 26px 22px 24px;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }
  .clinic-root .topic-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
  }
  .clinic-root .topic-card.t1::before { background: var(--green-lime); }
  .clinic-root .topic-card.t2::before { background: var(--coral); }
  .clinic-root .topic-card.t3::before { background: var(--green-med); }
  .clinic-root .topic-card.t4::before { background: var(--green-deep); }

  .clinic-root .topic-num {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--coral);
    margin-bottom: 14px;
  }
  .clinic-root .topic-card.t1 .topic-num { color: var(--green-med); }
  .clinic-root .topic-card.t3 .topic-num { color: var(--green-med); }
  .clinic-root .topic-card.t4 .topic-num { color: var(--green-med); }

  .clinic-root .topic-card h3 {
    font-size: 18px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .clinic-root .topic-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .clinic-root .topic-card li {
    padding: 8px 0 8px 18px;
    position: relative;
    border-bottom: 1px dashed var(--line);
    line-height: 1.45;
  }
  .clinic-root .topic-card li:last-child { border-bottom: none; }
  .clinic-root .topic-card li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--coral);
    font-size: 11px;
    top: 9px;
  }


  /* ============================================================
     4b) MEET YOUR COACHES — PLAYER CARDS
     ============================================================ */
  .clinic-root .players { padding: 80px 0 24px; }
  .clinic-root .players-head { margin-bottom: 36px; }
  .clinic-root .players-head h2 {
    font-size: clamp(28px, 4vw, 40px);
    text-transform: uppercase;
    margin: 8px 0 14px;
    max-width: 18ch;
  }
  .clinic-root .players-head h2 .accent { color: var(--coral); }
  .clinic-root .players-head p {
    font-size: 16px;
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0;
  }

  .clinic-root .player-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .clinic-root .player-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .clinic-root .player-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .clinic-root .player-photo {
    aspect-ratio: 4/5;
    background: linear-gradient(135deg, var(--green-deep) 0%, var(--green-med) 100%);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .clinic-root .player-photo::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 30% 30%, rgba(253,134,96,0.18), transparent 50%),
      radial-gradient(circle at 70% 80%, rgba(123,193,68,0.12), transparent 50%);
    pointer-events: none;
  }
  .clinic-root .player-photo svg {
    width: 50%;
    height: auto;
    color: rgba(255, 241, 224, 0.35);
    position: relative;
    z-index: 1;
  }
  .clinic-root .player-pos {
    position: absolute;
    top: 14px;
    left: 14px;
    background: var(--coral);
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 999px;
    z-index: 2;
  }
  .clinic-root .player-photo .swap-note {
    position: absolute;
    bottom: 12px;
    right: 14px;
    font-size: 9px;
    font-weight: 700;
    color: rgba(255, 241, 224, 0.5);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    z-index: 2;
  }
  .clinic-root .player-info {
    padding: 18px 20px 20px;
    border-top: 3px solid transparent;
  }
  .clinic-root .player-card:nth-child(3n+1) .player-info { border-top-color: var(--green-lime); }
  .clinic-root .player-card:nth-child(3n+2) .player-info { border-top-color: var(--green-med); }
  .clinic-root .player-card:nth-child(3n+3) .player-info { border-top-color: var(--coral); }

  .clinic-root .player-name {
    font-size: 17px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    margin-bottom: 6px;
    color: var(--ink);
  }
  .clinic-root .player-college {
    font-size: 13px;
    color: var(--ink-soft);
    font-weight: 600;
  }
  .clinic-root .player-college .year {
    color: var(--coral);
    font-weight: 700;
  }

  /* ============================================================
     5) PITCHING / CATCHING CALLOUT
     ============================================================ */
  .clinic-root .pcc {
    background: var(--green-lime);
    color: var(--green-deep);
    padding: 56px 0;
    position: relative;
    overflow: hidden;
  }
  .clinic-root .pcc-inner { position: relative; z-index: 1; max-width: 700px; }
  .clinic-root .pcc .pcc-tag {
    display: inline-block;
    background: var(--green-deep);
    color: var(--cream);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 16px;
  }
  .clinic-root .pcc h2 {
    font-size: clamp(28px, 4vw, 40px);
    text-transform: uppercase;
    margin-bottom: 14px;
    max-width: 18ch;
  }
  .clinic-root .pcc p {
    font-size: 16px;
    color: var(--ink);
    max-width: 60ch;
  }

  /* ============================================================
     6) WHAT'S INCLUDED
     ============================================================ */
  .clinic-root .included { padding: 80px 0; background: var(--cream-soft); }
  .clinic-root .included h2 {
    font-size: clamp(28px, 4vw, 40px);
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .clinic-root .included .sub { color: var(--ink-soft); margin-bottom: 36px; font-size: 15px; }
  .clinic-root .inc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .clinic-root .inc-card {
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 24px 22px;
  }
  .clinic-root .inc-card .inc-num {
    font-size: 12px;
    font-weight: 800;
    color: var(--coral);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .clinic-root .inc-card h4 {
    font-size: 16px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .clinic-root .inc-card p { font-size: 13.5px; color: var(--ink-soft); margin: 0; line-height: 1.5; }

  /* ============================================================
     7) SCHEDULE / DATES
     ============================================================ */
  .clinic-root .schedule { padding: 80px 0; }
  .clinic-root .schedule-head { margin-bottom: 32px; }
  .clinic-root .schedule h2 {
    font-size: clamp(28px, 4vw, 40px);
    text-transform: uppercase;
  }
  .clinic-root .session-single {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--green-deep);
    color: var(--cream);
    border-radius: 8px;
    overflow: hidden;
  }
  .clinic-root .session-block {
    padding: 36px 36px;
    position: relative;
  }
  .clinic-root .session-block + .session-block {
    border-left: 1px solid rgba(255, 241, 224, 0.16);
  }
  .clinic-root .session-eyebrow {
    font-size: 10px; font-weight: 800;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--peach);
    margin-bottom: 10px;
  }
  .clinic-root .session-date, .clinic-root .session-place {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 6px;
  }
  .clinic-root .session-time {
    font-size: 15px;
    color: rgba(255,241,224,0.78);
  }
  .clinic-root .session-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    padding: 8px 14px;
    border-radius: 4px;
    background: rgba(253, 134, 96, 0.16);
    color: var(--peach);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid rgba(253, 134, 96, 0.32);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .clinic-root .session-link:hover {
    background: rgba(253, 134, 96, 0.28);
    transform: translateY(-1px);
  }
  .clinic-root .session-link span {
    transition: transform 0.15s ease;
  }
  .clinic-root .session-link:hover span {
    transform: translateX(2px);
  }

  /* ============================================================
     8) WHAT TO WEAR & BRING
     ============================================================ */
  .clinic-root .bring { padding: 60px 0 80px; background: var(--cream-soft); }
  .clinic-root .bring h2 {
    font-size: clamp(26px, 3.5vw, 36px);
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .clinic-root .wear-bring-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }
  .clinic-root .wb-col h3 {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--coral);
    margin-bottom: 14px;
  }
  .clinic-root .wb-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 15.5px;
    color: var(--ink);
  }
  .clinic-root .wb-col li {
    padding: 10px 0 10px 24px;
    position: relative;
    border-bottom: 1px solid var(--line);
  }
  .clinic-root .wb-col li:last-child { border-bottom: none; }
  .clinic-root .wb-col li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 10px;
    color: var(--green-med);
    font-weight: 800;
  }
  .clinic-root .wb-col li.must {
    font-weight: 700;
  }
  .clinic-root .wb-col li.must::before {
    content: "★";
    color: var(--coral);
  }
  .clinic-root .wb-col li.note {
    color: var(--ink-soft);
    font-style: italic;
    font-size: 14px;
  }
  .clinic-root .wb-col li.note::before {
    content: "→";
    color: var(--coral);
    top: 9px;
  }
  .clinic-root .bring-col h4 {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--coral);
    margin-bottom: 12px;
  }
  .clinic-root .bring-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 15px;
    color: var(--ink);
  }
  .clinic-root .bring-col li {
    padding: 8px 0 8px 22px;
    position: relative;
    border-bottom: 1px solid var(--line);
  }
  .clinic-root .bring-col li::before {
    content: "✓";
    position: absolute; left: 0;
    color: var(--green-med);
    font-weight: 800;
  }
  .clinic-root .bring-col.skip li::before { content: "✕"; color: var(--coral); }

  /* ============================================================
     9) FAQ
     ============================================================ */
  .clinic-root .faqs { padding: 80px 0; }
  .clinic-root .faqs h2 {
    font-size: clamp(28px, 4vw, 40px);
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .clinic-root .faq {
